# ===== Godot 4 =====
# Editor cache / imported assets (regenerated on open).
# Ignore the CONTENTS, not the folder, so the one file below can be re-included.
.godot/*
# Keep the class_name registry so a fresh clone parses scripts headlessly
# (otherwise run `godot --headless --import` once after cloning).
!.godot/global_script_class_cache.cfg

# Keep: *.import, *.uid, export_presets.cfg (Godot 4 stores export
# credentials in .godot/export_credentials.cfg, which is ignored above).

# Generated from CSV translation sources
*.translation

# Mono / C# (unused here, harmless)
.mono/
data_*/
mono_crash.*.json

# Android build template
/android/

# ===== Exports / builds =====
/build/
/builds/
/export/
*.exe
*.pck
*.zip

# ===== Jam tools =====
node_modules/
tools/pixelfx/records/
tools/pixelfx/sheets/
__pycache__/
*.pyc

# ===== Claude Code / studio (per-machine, runtime) =====
.claude/settings.local.json
.claude/agent-memory/
.claude/worktrees/
CLAUDE.local.md
project.local.yaml
production/session-state/
production/session-logs/
.scratch/

# ===== Secrets =====
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# ===== OS / editors =====
.DS_Store
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.vs/
.vscode/
.idea/
*.swp
*~
*.tmp
*.log

# Windows bash crash dumps
*.stackdump

# gdUnit4 test-run HTML reports (generated)
reports/
