autowrap_mode = 3

[node name="GotItButton" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 4
tooltip_text = "Hide this hint for good"
theme_override_colors/font_color = Color(1, 0.93, 0.7, 1)
