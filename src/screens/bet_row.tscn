[gd_scene format=3]

[ext_resource type="Script" path="res://src/screens/bet_row.gd" id="1_row"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/check_on.png" id="2_on"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/check_off.png" id="3_off"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/check_on_disabled.png" id="4_on_dis"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/check_off_disabled.png" id="5_off_dis"]

[sub_resource type="StyleBoxEmpty" id="sb_toggle"]
content_margin_left = 2.0
content_margin_right = 2.0

[sub_resource type="StyleBoxFlat" id="sb_toggle_hover"]
content_margin_left = 2.0
content_margin_right = 2.0
bg_color = Color(0.1, 0.25, 0.2, 1)

[sub_resource type="StyleBoxFlat" id="sb_row"]
content_margin_left = 4.0
content_margin_top = 2.0
content_margin_right = 4.0
content_margin_bottom = 2.0
bg_color = Color(0.05, 0.12, 0.13, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2, 0.45, 0.3, 1)

[node name="BetRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 40)
theme_override_styles/panel = SubResource("sb_row")
script = ExtResource("1_row")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 2
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 2
theme_override_constants/margin_bottom = 0

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Toggle" type="CheckBox" parent="Margin/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(112, 0)
layout_mode = 2
tooltip_text = "Tick to bet on this claim"
theme_override_colors/font_color = Color(0.85, 1, 0.8, 1)
theme_override_colors/font_pressed_color = Color(0.6, 1, 0.35, 1)
theme_override_colors/font_hover_pressed_color = Color(0.6, 1, 0.35, 1)
theme_override_constants/h_separation = 6
theme_override_font_sizes/font_size = 14
theme_override_icons/checked = ExtResource("2_on")
theme_override_icons/unchecked = ExtResource("3_off")
theme_override_icons/checked_disabled = ExtResource("4_on_dis")
theme_override_icons/unchecked_disabled = ExtResource("5_off_dis")
theme_override_styles/normal = SubResource("sb_toggle")
theme_override_styles/pressed = SubResource("sb_toggle")
theme_override_styles/disabled = SubResource("sb_toggle")
theme_override_styles/hover = SubResource("sb_toggle_hover")
theme_override_styles/hover_pressed = SubResource("sb_toggle_hover")
theme_override_styles/focus = SubResource("sb_toggle_hover")
text = "Victory"

[node name="Info" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="DescLabel" type="Label" parent="Margin/HBox/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "Win the battle."
autowrap_mode = 3

[node name="ReasonLabel" type="Label" parent="Margin/HBox/Info"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.6, 0.3, 1)
theme_override_font_sizes/font_size = 10
text = "Not possible in this fight."
autowrap_mode = 3

[node name="OddsLabel" type="Label" parent="Margin/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(92, 0)
layout_mode = 2
mouse_filter = 0
theme_override_font_sizes/font_size = 12
text = "Likely 87%"
horizontal_alignment = 1
vertical_alignment = 1

[node name="MvpOption" type="OptionButton" parent="Margin/HBox"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(86, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 10

[node name="StakeSpin" type="SpinBox" parent="Margin/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Stake (up to half your gold)"
min_value = 5.0
max_value = 100.0
step = 5.0
value = 10.0
suffix = "g"

[node name="Outcome" type="VBoxContainer" parent="Margin/HBox"]
custom_minimum_size = Vector2(72, 0)
layout_mode = 2
theme_override_constants/separation = 0
alignment = 1

[node name="WinLabel" type="Label" parent="Margin/HBox/Outcome"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 1, 0.45, 1)
theme_override_font_sizes/font_size = 10
text = "Win +9g"

[node name="LoseLabel" type="Label" parent="Margin/HBox/Outcome"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.45, 0.4, 1)
theme_override_font_sizes/font_size = 10
text = "Lose -10g"
